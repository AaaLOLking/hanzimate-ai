APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql+psycopg://hanzimate:hanzimate@localhost:5432/hanzimate
DATABASE_AUTO_CREATE=false
REDIS_URL=redis://localhost:6379/0

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_USER_ID=00000000-0000-4000-8000-000000000001

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
SUMMARY_TIMEOUT_SECONDS=30
MODEL_DAILY_EXTERNAL_CALL_LIMIT=40
MODEL_DAILY_BUDGET_YUAN=5
# 按所用模型的最新官方价格填写；留空或 0 时只启用次数保护，不展示费用。
DEEPSEEK_INPUT_PRICE_YUAN_PER_MILLION_TOKENS=0
DEEPSEEK_OUTPUT_PRICE_YUAN_PER_MILLION_TOKENS=0

DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=beijing
QWEN_REALTIME_MODEL=qwen3.5-omni-flash-realtime
QWEN_REALTIME_VOICE=Tina
REALTIME_SESSION_SECONDS=480

# Optional read-only agent tools; HSK course lookup needs no external key.
TAVILY_API_KEY=
TOOL_TIMEOUT_SECONDS=15
TOOL_EXTERNAL_SESSION_LIMIT=20
# expert_answer reuses DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_DEFAULT_MODEL.

XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

EMBEDDING_MODEL=text-embedding-v4
